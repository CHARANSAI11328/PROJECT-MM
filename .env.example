# MAMEKA MAHODAYAM - Environment Configuration Example
# Copy this file to .env and configure your production settings

PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret

# --- LIVE DATABASE CONFIGURATION (Neon PostgreSQL / Supabase) ---
# If DATABASE_URL is provided, the platform automatically connects to your live Cloud PostgreSQL DB.
# If DATABASE_URL is omitted or commented out, it falls back to local SQLite (database.sqlite).
# DATABASE_URL=postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- CLOUD MEDIA STORAGE CONFIGURATION (Cloudflare R2 / AWS S3) ---
# If R2 credentials are provided, uploaded newspaper PDFs and images are saved to Cloudflare R2 / S3.
# R2_BUCKET_NAME=mameka-media-bucket
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_PUBLIC_URL=https://pub-your-id.r2.dev

# --- LOCAL PATH FALLBACKS ---
DATABASE_PATH=./database.sqlite
MEDIA_UPLOADS_DIR=./uploads/media
EDITION_UPLOADS_DIR=./uploads/editions
PACKAGE_UPLOADS_DIR=./uploads/packages
ALLOWED_ORIGINS=http://localhost:3000,https://mamekamahodayam.com
